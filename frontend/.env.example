# Copy this file to `.env.local` and adjust as needed.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored — it is where your machine-specific values live.
# This file is committed and documents which variables exist.

# Origin of the FABINS backend API (no trailing slash).
#
# The `NEXT_PUBLIC_` prefix exposes this value to browser code, which is
# required here because the contact form calls the API from the browser.
# Anything with this prefix is publicly visible — never put a secret in one.
#
# Local development: the Spring Boot default port.
# Production: the deployed API origin, e.g. https://api.fabins.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
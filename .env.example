# =============================================================================
# FABINS — Environment Configuration Template
#
# Copy this file to `.env` in the repository root before running Docker Compose:
#   cp .env.example .env
#
# `.env` is gitignored. It is also read directly by the backend when it is
# started from source (see FabinsApplication#loadDotEnv), so a single file
# covers both `docker compose up` and `./mvnw spring-boot:run`.
#
# The variable names here are exactly the ones to create on Render (backend)
# and Vercel (frontend). See docs/CICD_AND_DEPLOYMENT.md for which go where.
# =============================================================================

# --- DATABASE CONFIGURATION ---------------------------------------------------
# Used by the postgres container in docker-compose.yml. On Render these are not
# set at all: the managed database injects DATABASE_URL instead, in libpq form
# (postgres://user:pass@host/db), which FabinsApplication rewrites into a JDBC
# URL at startup. See docs/CICD_AND_DEPLOYMENT.md §2.
POSTGRES_DB=fabins
POSTGRES_USER=fabins_user
POSTGRES_PASSWORD=fabins_secret_pass_2026!
POSTGRES_PORT=5432

# --- SPRING BOOT BACKEND CONFIGURATION ----------------------------------------
# Credentials for the admin-only endpoints (HTTP Basic).
FABINS_ADMIN_USERNAME=admin
FABINS_ADMIN_PASSWORD=SuperSecureAdminPassword2026!

# Browser origin allowed to call the API. Must match exactly where the site is
# served from — scheme, host and port. Production: https://fabins.com
FABINS_ALLOWED_ORIGIN=http://localhost:3000

# This API's own public origin. Used only to build the absolute acknowledge
# link embedded in notification emails, so it must be reachable from a mail
# client, not just from the container. Production: https://api.fabins.com
FABINS_BACKEND_URL=http://localhost:8080

# --- AUTOMATED EMAIL NOTIFICATION CONFIGURATION (BREVO) -----------------------
# Leave SPRING_MAIL_PASSWORD blank to develop without a mail account: the app
# logs each message instead of sending it.
#
# A Brevo key (xsmtpsib-…) selects the HTTPS REST engine, which is the one that
# works on cloud PaaS providers. The SMTP settings below are the fallback only.
#
# PORT 465 (implicit SSL), not 587 (STARTTLS): most PaaS providers blackhole
# outbound 587, so it hangs rather than failing. See docs/CICD_AND_DEPLOYMENT.md §3.
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=465
# Brevo's SMTP login, from the Brevo dashboard → SMTP & API. NOT the sender address.
SPRING_MAIL_USERNAME=b3c905001@smtp-brevo.com
SPRING_MAIL_PASSWORD=xsmtpsib-your_brevo_key_here
# Sender address. Must be a verified sender in the Brevo account.
SPRING_MAIL_FROM=saturn.rnd.innovation@gmail.com

# --- FRONTEND NEXT.JS CONFIGURATION -------------------------------------------
# Origin of the API — no /api/v1 suffix, no trailing slash. Inlined into the
# browser bundle at build time, so a change needs a redeploy, not a restart.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080